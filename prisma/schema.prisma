generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  password        String?
  name            String?
  role            String    @default("USER")
  resetPinHash    String?
  resetPinExpires DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SiteSettings {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  key           String  @unique
  name          String
  nameTamil     String?
  tagline       String
  location      String
  locationTamil String?
  description   String?
  contactsJson  String
}

model HeroContent {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  key          String  @unique
  tagline      String
  subtitle     String
  imageUrl     String?
  ctaPrimary   String  @default("Get a Quote")
  ctaSecondary String  @default("Call Now")
}

model AboutContent {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique
  eyebrow     String
  title       String
  description String
  details     String?
  footerNote  String?
  imageOneUrl String?
  imageTwoUrl String?
  peopleJson  String?
}

model ServiceItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  title       String
  description String
  details     String?
  icon        String
  order       Int     @default(0)
}

model GalleryMedia {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  type      String
  caption   String?
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
